# SecureSight Configuration
# Copy this to .env:  cp .env.example .env
# This is the only config file you need. Used by both Docker and local dev.

# Server
PORT=5001
HOST=0.0.0.0

# Database (MySQL) — all marked REQUIRED will cause a startup error if missing
DB_HOST=mysql
DB_PORT=3306
DB_USER=                                            # REQUIRED
DB_PASSWORD=                                        # REQUIRED
DB_NAME=securesight

# Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                                     # REQUIRED
JWT_SECRET=                                         # REQUIRED — min 32 bytes, used to sign JWTs
JWT_EXPIRY_HOURS=24
CAMERA_API_KEY=                                     # REQUIRED

# MySQL root password (used only by docker-compose)
MYSQL_ROOT_PASSWORD=                                # REQUIRED

# CORS — add your machine's LAN IP for access from other devices
# Example: CORS_ORIGINS=http://localhost:3000,https://localhost:3443,https://192.168.1.100:3443
# CORS_ORIGINS=
