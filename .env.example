# SecureSight Configuration
# Copy this to .env:  cp .env.example .env
# This is the only config file you need. Used by both Docker and local dev.

# Server
PORT=5001
HOST=0.0.0.0

# Database (SQLite)
DB_PATH=recognition.db

# Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=securesight2026
JWT_SECRET=securesight-jwt-secret-2026              # Leave blank to auto-generate
JWT_EXPIRY_HOURS=24
CAMERA_API_KEY=securesight-camera-2026              # Leave blank to auto-generate (printed in logs)

# CORS — add your machine's LAN IP for access from other devices
# Example: CORS_ORIGINS=http://localhost:3000,https://localhost:3443,https://192.168.1.100:3443
# CORS_ORIGINS=
