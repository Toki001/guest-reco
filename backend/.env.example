# SecureSight Backend Configuration
# Copy this file to .env.local and adjust values

# Server
PORT=5001
HOST=0.0.0.0

# Database (SQLite)
DB_PATH=recognition.db

# Auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=securesight2026
JWT_SECRET=                       # Leave blank to auto-generate (set for production!)
JWT_EXPIRY_HOURS=24
CAMERA_API_KEY=                   # Leave blank to auto-generate

# CORS (comma-separated origins)
CORS_ORIGINS=https://localhost:3000,https://127.0.0.1:3000
