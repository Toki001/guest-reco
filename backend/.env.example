# SecureSight Backend Configuration
# Copy this file to .env.local and adjust values

# Server
PORT=5001
HOST=0.0.0.0

# Database (SQLite)
DB_PATH=recognition.db

# Storage directories
AVATARS_DIR=avatars
SNAPSHOTS_DIR=snapshots

# Face Recognition
# Lower = stricter matching (0.4-0.6 recommended)
FACE_DISTANCE_THRESHOLD=0.6
